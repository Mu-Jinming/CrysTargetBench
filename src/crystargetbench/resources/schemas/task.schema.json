{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "ctb.task.v2"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "screen",
        "measure",
        "constrained_rank"
      ]
    },
    "reference_geometry": {
      "enum": [
        "input",
        "relaxed"
      ]
    },
    "metric_scope": {
      "const": "submission"
    },
    "measurements": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "property_id": {
            "enum": [
              "phonon_path_min_frequency_THz",
              "phonon_mesh_min_frequency_THz",
              "band_gap_eV",
              "space_group_number",
              "bulk_modulus_voigt_GPa",
              "bulk_modulus_reuss_GPa",
              "bulk_modulus_hill_GPa",
              "bulk_modulus_eos_GPa",
              "dielectric_ionic_nominal_trace_over3",
              "dielectric_electronic_trace_over3",
              "dielectric_ionic_bec_trace_over3",
              "dielectric_total_static_trace_over3"
            ]
          },
          "unit": {
            "enum": [
              "THz",
              "eV",
              "1",
              "GPa"
            ]
          },
          "definition_id": {
            "type": "string",
            "minLength": 1
          },
          "required_fidelity": {
            "enum": [
              "protocol_default",
              "native",
              "mlff",
              "dft",
              "surrogate"
            ]
          }
        },
        "required": [
          "property_id",
          "unit"
        ]
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "measurement": {
                "type": "string",
                "minLength": 1
              },
              "operator": {
                "const": "gt"
              },
              "value": {
                "type": "number"
              }
            },
            "required": [
              "id",
              "measurement",
              "operator",
              "value"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "measurement": {
                "type": "string",
                "minLength": 1
              },
              "operator": {
                "const": "ge"
              },
              "value": {
                "type": "number"
              }
            },
            "required": [
              "id",
              "measurement",
              "operator",
              "value"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "measurement": {
                "type": "string",
                "minLength": 1
              },
              "operator": {
                "const": "lt"
              },
              "value": {
                "type": "number"
              }
            },
            "required": [
              "id",
              "measurement",
              "operator",
              "value"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "measurement": {
                "type": "string",
                "minLength": 1
              },
              "operator": {
                "const": "le"
              },
              "value": {
                "type": "number"
              }
            },
            "required": [
              "id",
              "measurement",
              "operator",
              "value"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "measurement": {
                "type": "string",
                "minLength": 1
              },
              "operator": {
                "const": "eq"
              },
              "value": {
                "type": "integer"
              }
            },
            "required": [
              "id",
              "measurement",
              "operator",
              "value"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "measurement": {
                "type": "string",
                "minLength": 1
              },
              "operator": {
                "const": "in"
              },
              "values": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "integer"
                }
              }
            },
            "required": [
              "id",
              "measurement",
              "operator",
              "values"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "measurement": {
                "type": "string",
                "minLength": 1
              },
              "operator": {
                "const": "within"
              },
              "value": {
                "type": "number"
              },
              "atol": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "id",
              "measurement",
              "operator",
              "value",
              "atol"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "measurement": {
                "type": "string",
                "minLength": 1
              },
              "operator": {
                "const": "interval"
              },
              "lower": {
                "type": "number"
              },
              "upper": {
                "type": "number"
              },
              "lower_inclusive": {
                "type": "boolean"
              },
              "upper_inclusive": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "measurement",
              "operator",
              "lower",
              "upper",
              "lower_inclusive",
              "upper_inclusive"
            ]
          }
        ]
      }
    },
    "ranking": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "measurement": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": [
            "maximize",
            "minimize"
          ]
        }
      },
      "required": [
        "measurement",
        "direction"
      ]
    },
    "report": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "mode",
    "reference_geometry",
    "measurements"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "screen"
          }
        }
      },
      "then": {
        "required": [
          "constraints"
        ],
        "properties": {
          "constraints": {
            "minItems": 1
          }
        },
        "not": {
          "required": [
            "ranking"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "constrained_rank"
          }
        }
      },
      "then": {
        "required": [
          "constraints",
          "ranking"
        ],
        "properties": {
          "constraints": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "measure"
          }
        }
      },
      "then": {
        "required": [
          "report"
        ],
        "properties": {
          "constraints": {
            "maxItems": 0
          }
        },
        "not": {
          "required": [
            "ranking"
          ]
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Business validation must check finite values, no boolean-as-number, exact SG integers, property/units, alias references, unique IDs, definition compatibility and nonempty intervals. Task data never executes code."
}
